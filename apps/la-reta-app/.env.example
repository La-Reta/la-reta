# URL del backend Next (apps/la-reta-web). En un dispositivo o simulador
# `localhost` es el propio teléfono, no tu máquina: usa la IP de tu red local
# (p. ej. http://192.168.1.50:3000) o un túnel. Sin esta variable el cliente
# cae a http://localhost:3000, que solo sirve en el simulador web.
EXPO_PUBLIC_API_URL="http://localhost:3000"

# Llave publicable de Clerk. Tiene que ser la de la MISMA instancia que la web
# (apps/la-reta-web), o las cuentas de los dos clientes no serían las mismas.
# No es un secreto: viaja en el bundle del cliente por diseño.
#
# Sin ella la app arranca igual, en modo público —auth-provider.tsx omite el
# ClerkProvider en vez de reventar— y las pantallas de acceso explican qué
# falta. Con ella, la sesión se guarda en el keychain y viaja a la API como
# Authorization: Bearer.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=""
