node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
# `ios/` y `android/` los genera `expo prebuild` a partir de app.json y los
# plugins, así que se quedan fuera del repo: versionarlos invita a editarlos a
# mano y perder esos cambios en el siguiente prebuild. La configuración vive en
# app.json, que sí está versionado.
/ios
/android

*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example
