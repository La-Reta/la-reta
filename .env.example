# Neon Postgres connection string.
# Cópialo a .env.local y pega tu URL real (Neon → Dashboard → Connection string).
# Usa la URL "pooled" para la app y migraciones funciona con cualquiera.
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# PIN para la zona de administración (/admin). Si no lo defines, usa "reta2026".
ADMIN_PIN="reta2026"

# Contraseña para abrir el marcador en vivo (/live). Si no la defines, usa "gol2026".
LIVE_PIN="gol2026"

# Cloudflare Web Analytics token público del sitio.
# No guardes la URL del script en env; solo el token del beacon.
NEXT_PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=""

# Canonical/OG base URL (producción). En Vercel se infiere de VERCEL_URL si falta.
NEXT_PUBLIC_SITE_URL="https://tu-dominio.com"

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
